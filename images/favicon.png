    </span><span><span class="hljs-comment">&lt;!-- 🇵🇱 Sekcja z polecanymi produktami --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"featured"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Utvalda bakverk</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"gallery"</span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"images/choco_berry_cake.jpg"</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"Chokladtårta med bär"</span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"images/brownie.jpg"</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"Kladdkaka med chokladsås"</span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"images/strawberries_tart.jpg"</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"Jordgubbspaj med blåbär"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;
            Läs mer om våra klassiska svenska bakverk på 
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"https://sv.wikipedia.org/wiki/Prinsesstårta"</span></span><span> </span><span><span class="hljs-attr">target</span></span><span>=</span><span><span class="hljs-string">"_blank"</span></span><span>&gt;Wikipedia</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;.
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;

    </span><span><span class="hljs-comment">&lt;!-- 🇸🇪 Sidfoten --&gt;</span></span><span>
    </span><span><span class="hljs-comment">&lt;!-- 🇵🇱 Stopka z danymi i prawami autorskimi --&gt;</span></span><span>
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">footer</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;</span><span><span class="hljs-symbol">&amp;copy;</span></span><span> 2025 Sotok Elegant | Skapat av Arkadiusz Tokarczyk</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">footer</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">body</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">html</span></span></span><span>&gt;
</span></span></code></div></div></pre>
