6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Kopiera kod</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-css"><span><span><span class="hljs-comment">/* 🇸🇪 Grundinställningar för hela sidan */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Podstawowe ustawienia strony */</span></span><span>
</span><span><span class="hljs-selector-tag">body</span></span><span> {
    </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
    </span><span><span class="hljs-attribute">font-family</span></span><span>: </span><span><span class="hljs-string">"Poppins"</span></span><span>, Arial, sans-serif;
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#fff8f0</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#3c3c3c</span></span><span>;
}

</span><span><span class="hljs-comment">/* 🇸🇪 Hero-sektion med bakgrundsbild */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Sekcja główna z tłem */</span></span><span>
</span><span><span class="hljs-selector-class">.hero</span></span><span> {
    </span><span><span class="hljs-attribute">background-image</span></span><span>: </span><span><span class="hljs-built_in">url</span></span><span>(</span><span><span class="hljs-string">"../images/cake_look.jpeg"</span></span><span>);
    </span><span><span class="hljs-attribute">background-size</span></span><span>: cover;
    </span><span><span class="hljs-attribute">background-position</span></span><span>: center;
    </span><span><span class="hljs-attribute">height</span></span><span>: </span><span><span class="hljs-number">90vh</span></span><span>;
    </span><span><span class="hljs-attribute">display</span></span><span>: flex;
    </span><span><span class="hljs-attribute">justify-content</span></span><span>: center;
    </span><span><span class="hljs-attribute">align-items</span></span><span>: center;
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
    </span><span><span class="hljs-attribute">color</span></span><span>: white;
    </span><span><span class="hljs-attribute">position</span></span><span>: relative;
}

</span><span><span class="hljs-selector-class">.hero</span></span><span><span class="hljs-selector-pseudo">::after</span></span><span> {
    </span><span><span class="hljs-comment">/* 🇵🇱 Półprzezroczysty filtr dla kontrastu tekstu */</span></span><span>
    </span><span><span class="hljs-attribute">content</span></span><span>: </span><span><span class="hljs-string">""</span></span><span>;
    </span><span><span class="hljs-attribute">position</span></span><span>: absolute;
    </span><span><span class="hljs-attribute">top</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>; </span><span><span class="hljs-attribute">left</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>; </span><span><span class="hljs-attribute">right</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>; </span><span><span class="hljs-attribute">bottom</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
    </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">0.4</span></span><span>);
}

</span><span><span class="hljs-selector-class">.hero-text</span></span><span> {
    </span><span><span class="hljs-attribute">position</span></span><span>: relative;
    </span><span><span class="hljs-attribute">z-index</span></span><span>: </span><span><span class="hljs-number">1</span></span><span>;
}

</span><span><span class="hljs-selector-class">.hero-text</span></span><span> </span><span><span class="hljs-selector-tag">h1</span></span><span> {
    </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">3em</span></span><span>;
    </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
}

</span><span><span class="hljs-selector-class">.hero-text</span></span><span> </span><span><span class="hljs-selector-class">.brand</span></span><span> {
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#f39c12</span></span><span>; </span><span><span class="hljs-comment">/* 🇵🇱 Pomarańczowy akcent */</span></span><span>
}

</span><span><span class="hljs-selector-class">.hero-text</span></span><span> </span><span><span class="hljs-selector-tag">p</span></span><span> {
    </span><span><span class="hljs-attribute">font-size</span></span><span>: </span><span><span class="hljs-number">1.5em</span></span><span>;
    </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">0.5em</span></span><span>;
}

</span><span><span class="hljs-selector-class">.cta</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: inline-block;
    </span><span><span class="hljs-attribute">margin-top</span></span><span>: </span><span><span class="hljs-number">1.5em</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0.7em</span></span><span> </span><span><span class="hljs-number">1.5em</span></span><span>;
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#c0392b</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: white;
    </span><span><span class="hljs-attribute">text-decoration</span></span><span>: none;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">font-weight</span></span><span>: bold;
    </span><span><span class="hljs-attribute">transition</span></span><span>: background </span><span><span class="hljs-number">0.3s</span></span><span>;
}

</span><span><span class="hljs-selector-class">.cta</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#e74c3c</span></span><span>;
}

</span><span><span class="hljs-comment">/* 🇸🇪 Navigationsmeny */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Menu nawigacyjne */</span></span><span>
</span><span><span class="hljs-selector-tag">nav</span></span><span> {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#2c3e50</span></span><span>;
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
}

</span><span><span class="hljs-selector-tag">nav</span></span><span> </span><span><span class="hljs-selector-tag">ul</span></span><span> {
    </span><span><span class="hljs-attribute">margin</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>;
    </span><span><span class="hljs-attribute">list-style</span></span><span>: none;
}

</span><span><span class="hljs-selector-tag">nav</span></span><span> </span><span><span class="hljs-selector-tag">li</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: inline-block;
}

</span><span><span class="hljs-selector-tag">nav</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: block;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span> </span><span><span class="hljs-number">25px</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: white;
    </span><span><span class="hljs-attribute">text-decoration</span></span><span>: none;
    </span><span><span class="hljs-attribute">font-weight</span></span><span>: bold;
}

</span><span><span class="hljs-selector-tag">nav</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span>,
</span><span><span class="hljs-selector-tag">nav</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span><span class="hljs-selector-class">.active</span></span><span> {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#f39c12</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#2c3e50</span></span><span>;
}

</span><span><span class="hljs-comment">/* 🇸🇪 Intro-sektion */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Sekcja wprowadzająca */</span></span><span>
</span><span><span class="hljs-selector-class">.intro</span></span><span> {
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">40px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-comment">/* 🇸🇪 Sektion med utvalda bakverk */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Sekcja z produktami */</span></span><span>
</span><span><span class="hljs-selector-class">.featured</span></span><span> {
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#fff1e6</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">40px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.featured</span></span><span> </span><span><span class="hljs-selector-tag">h2</span></span><span> {
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#c0392b</span></span><span>;
}

</span><span><span class="hljs-selector-class">.gallery</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: flex;
    </span><span><span class="hljs-attribute">flex-wrap</span></span><span>: wrap;
    </span><span><span class="hljs-attribute">justify-content</span></span><span>: center;
    </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.gallery</span></span><span> </span><span><span class="hljs-selector-tag">img</span></span><span> {
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">300px</span></span><span>;
    </span><span><span class="hljs-attribute">height</span></span><span>: auto;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">4px</span></span><span> </span><span><span class="hljs-number">8px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0.2</span></span><span>);
    </span><span><span class="hljs-attribute">transition</span></span><span>: transform </span><span><span class="hljs-number">0.3s</span></span><span>;
}

</span><span><span class="hljs-selector-class">.gallery</span></span><span> </span><span><span class="hljs-selector-tag">img</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
    </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">scale</span></span><span>(</span><span><span class="hljs-number">1.05</span></span><span>);
}

</span><span><span class="hljs-comment">/* 🇸🇪 Sidfot */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Stopka */</span></span><span>
</span><span><span class="hljs-selector-tag">footer</span></span><span> {
