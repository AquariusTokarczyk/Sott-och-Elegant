    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">figure</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"gallery-item"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">"images/cake-1145609_1920.jpg"</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"Prinsesstårta"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">figcaption</span></span></span><span>&gt;Prinsesstårta</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">figcaption</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">"https://sv.wikipedia.org/wiki/Prinsesstårta"</span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"readmore"</span></span><span> </span><span><span class="hljs-attr">target</span></span><span>=</span><span><span class="hljs-string">"_blank"</span></span><span>&gt;Läs mer</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">figure</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;

  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">footer</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;</span><span><span class="hljs-symbol">&amp;copy;</span></span><span> 2025 Sött och Elegant | Skapat av Arkadiusz Tokarczyk</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">footer</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">body</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">html</span></span></span><span>&gt;
</span></span></code></div></div></pre>
