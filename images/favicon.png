    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Hantverk, hjärta och smak – varje dag</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">header</span></span></span><span>&gt;

