</span><span><span class="hljs-comment">/* 🇵🇱 Nagłówek podstron */</span></span><span>
</span><span><span class="hljs-selector-class">.subpage-header</span></span><span> {
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">60px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#fff1e6</span></span><span>;
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#c0392b</span></span><span>;
}

</span><span><span class="hljs-comment">/* 🇸🇪 Produktkort */</span></span><span>
</span><span><span class="hljs-comment">/* 🇵🇱 Karty produktów */</span></span><span>
</span><span><span class="hljs-selector-class">.products</span></span><span> {
    </span><span><span class="hljs-attribute">display</span></span><span>: flex;
    </span><span><span class="hljs-attribute">flex-wrap</span></span><span>: wrap;
    </span><span><span class="hljs-attribute">justify-content</span></span><span>: center;
    </span><span><span class="hljs-attribute">gap</span></span><span>: </span><span><span class="hljs-number">25px</span></span><span>;
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">40px</span></span><span> </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">background-color</span></span><span>: </span><span><span class="hljs-number">#fffaf5</span></span><span>;
}

</span><span><span class="hljs-selector-class">.product-card</span></span><span> {
    </span><span><span class="hljs-attribute">background-color</span></span><span>: white;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span>;
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">280px</span></span><span>;
    </span><span><span class="hljs-attribute">box-shadow</span></span><span>: </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-number">4px</span></span><span> </span><span><span class="hljs-number">10px</span></span><span> </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0.15</span></span><span>);
    </span><span><span class="hljs-attribute">padding</span></span><span>: </span><span><span class="hljs-number">20px</span></span><span>;
    </span><span><span class="hljs-attribute">text-align</span></span><span>: center;
    </span><span><span class="hljs-attribute">transition</span></span><span>: transform </span><span><span class="hljs-number">0.3s</span></span><span>;
}

</span><span><span class="hljs-selector-class">.product-card</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
    </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">scale</span></span><span>(</span><span><span class="hljs-number">1.03</span></span><span>);
}

</span><span><span class="hljs-selector-class">.product-card</span></span><span> </span><span><span class="hljs-selector-tag">img</span></span><span> {
    </span><span><span class="hljs-attribute">width</span></span><span>: </span><span><span class="hljs-number">100%</span></span><span>;
    </span><span><span class="hljs-attribute">border-radius</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">15px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.product-card</span></span><span> </span><span><span class="hljs-selector-tag">h3</span></span><span> {
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#c0392b</span></span><span>;
    </span><span><span class="hljs-attribute">margin-bottom</span></span><span>: </span><span><span class="hljs-number">10px</span></span><span>;
}

</span><span><span class="hljs-selector-class">.product-card</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span> {
    </span><span><span class="hljs-attribute">color</span></span><span>: </span><span><span class="hljs-number">#f39c12</span></span><span>;
    </span><span><span class="hljs-attribute">text-decoration</span></span><span>: none;
    </span><span><span class="hljs-attribute">font-weight</span></span><span>: bold;
}

</span><span><span class="hljs-selector-class">.product-card</span></span><span> </span><span><span class="hljs-selector-tag">a</span></span><span><span class="hljs-selector-pseudo">:hover</span></span><span> {
    </span><span><span class="hljs-attribute">text-decoration</span></span><span>: underline;
}
</span></span></code></div></div></pre>
<hr data-start="5592" data-end="5595">
<p data-start="5597" data-end="5617">✅ <strong data-start="5599" data-end="5617">Efekt końcowy:</strong></p>
<ul data-start="5618" data-end="5822">
<li data-start="5618" data-end="5659">
<p data-start="5620" data-end="5659">pełna strona „Produkter” po szwedzku,</p>
</li>
<li data-start="5660" data-end="5710">
<p data-start="5662" data-end="5710">wszystkie Twoje zdjęcia w eleganckich kartach,</p>
</li>
<li data-start="5711" data-end="5763">
<p data-start="5713" data-end="5763">pastelowo-pomarańczowe i ciemnoczerwone akcenty,</p>
</li>
<li data-start="5764" data-end="5822">
<p data-start="5766" data-end="5822">linki do artykułów o klasycznych szwedzkich wypiekach.</p>
</li>
</ul>
<hr data-start="5824" data-end="5827">
<p data-start="5829" data-end="6022" data-is-last-node="" data-is-only-node="">👉 Kolejny krok (etap 3):<br data-start="5854" data-end="5857">
strona <strong data-start="5864" data-end="5876">„Om oss”</strong> z Twoim zdjęciem zespołu (<code data-start="5903" data-end="5913">team.jpg</code>), krótką historią firmy i sekcją „Vårt mål” („Nasz cel”).<br data-start="5971" data-end="5974">
Czyli kontynuuję od razu i tworzę <code data-start="6008" data-end="6021">om_oss.html</code>.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Kopiera" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4