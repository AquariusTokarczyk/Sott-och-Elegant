com%2Favatars%2Fav.png\",\"created\",1726586884,\"first_name\"]\n");</script><script nonce="">window.__reactRouterContext.streamController.enqueue("P4056:[{\"_4075\":4076,\"_4262\":3589,\"_4263\":3596,\"_4264\":1799},\"items\",[4077,4089,4094,4099,4104,4112,4117,4122,4127,4136,4141,4146,4151,4160,4165,4170,4175,4182,4187,4192,4197,4204,4209,4214,4219,4225,4230,4235,4240,4247,4252,4257],{\"_23\":4078,\"_4079\":4080,\"_4081\":4082,\"_4083\":4084,\"_2070\":4085,\"_4086\":4080,\"_4087\":73,\"_4088\":2512},\"1b3b651a\",\"title\",\"Skapa en bild\",\"description\",\"för min presentation\",\"oneliner\",\"Skapa en bild för min presentation\",\"Kan du skapa en bild för min presentation? Jag behöver något som visuellt återspeglar de viktigaste punkterna.\",\"theme\",\"requires_dalle\",\"category\",{\"_23\":4090,\"_4079\":4080,\"_4081\":4091,\"_4083\":4092,\"_2070\":4093,\"_4086\":4080,\"_4087\":73,\"_4088\":2512},\"546d7231\",\"av mitt husdjur\",\"Skapa en bild av mitt husdjur\",\"Kan du skapa en bild av mitt husdjur? Jag vill ha ett roligt och kreativt porträtt.\",{\"_23\":4095,\"_4079\":4080,\"_4081\":4096,\"_4083\":4097,\"_2070\":4098,\"_4086\":4080,\"_4087\":73,\"_4088\":2512},\"4c694c02\",\"till min webbplats\",\"Skapa en bild till min webbplats\",\"Kan du skapa en bild till min webbplats? Jag behöver något som passar med övergripande tema och ton.\",{\"_23\":4100,\"_4079\":4080,\"_4081\":4101,\"_4083\":4102,\"_2070\":4103,\"_4086\":4080,\"_4087\":73,\"_4088\":2512},\"2e7059f5\",\"gjord av filt\",\"Skapa en bild gjord av filt\",\"Kan du skapa en bild som ser ut som om den är gjord av filt? Jag vill att den ska se handgjord och ojämn ut.\",{\"_23\":4105,\"_4079\":4106,\"_4081\":4107,\"_4083\":4108,\"_2070\":4109,\"_4086\":4110,\"_4088\":4111},\"fc3029cd\",\"Brainstorma idéer\",\"till min nästa semester\",\"Brainstorma idéer till min nästa semester\",\"Nu brainstormar vi idéer till min nästa semester. Börja med att fråga när på året jag vill resa.\",\"Brainstorma\",\"idea\",{\"_23\":4113,\"_4079\":4106,\"_4081\":4114,\"_4083\":4115,\"_2070\":4116,\"_4086\":4110,\"_4088\":4111},\"d0b8a02b\",\"till en reklamkampanj\",\"Brainstorma idéer till en reklamkampanj\",\"Kan du hjälpa mig brainstorma idéer till en reklamkampanj? Börja med att fråga om målgruppen.\",{\"_23\":4118,\"_4079\":4106,\"_4081\":4119,\"_4083\":4120,\"_2070\":4121,\"_4086\":4110,\"_4088\":4111},\"4cc64126\",\"till en ny träningsrutin\",\"Brainstorma idéer till en ny träningsrutin\",\"Kan du hjälpa mig skapa en ny träningsrutin?\",{\"_23\":4123,\"_4079\":4106,\"_4081\":4124,\"_4083\":4125,\"_2070\":4126,\"_4086\":4110,\"_4088\":4111},\"dd7f8484\",\"till menyn för en middagsbjudning\",\"Brainstorma idéer till menyn för en middagsbjudning\",\"Kan du hjälpa mig brainstorma idéer till menyn för en middagsbjudning? Vi börjar med att hitta säsongsmässiga ingredienser.\",{\"_23\":4128,\"_4079\":4129,\"_4081\":4130,\"_4083\":4131,\"_2070\":4132,\"_4086\":4133,\"_4088\":4134,\"_4135\":73},\"58a3e0b6\",\"Sammanfatta\",\"mitt hyresavtal\",\"Sammanfatta mitt hyresavtal\",\"Kan du sammanfatta mitt hyresavtal? Jag vill ha huvudpunkterna och eventuella viktiga paragrafer. Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",\"Sammanfatta text\",\"file-upload-document\",\"requires_file_upload\",{\"_23\":4137,\"_4079\":4129,\"_4081\":4138,\"_4083\":4139,\"_2070\":4140,\"_4086\":4133,\"_4088\":4134,\"_4135\":73},\"7db8304d\",\"mötesanteckningar\",\"Sammanfatta mötesanteckningar\",\"Kan du sammanfatta mina mötesanteckningar? Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",{\"_23\":4142,\"_4079\":4129,\"_4081\":4143,\"_4083\":4144,\"_2070\":4145,\"_4086\":4133,\"_4088\":4134,\"_4135\":73},\"87f60f46\",\"första kapitlet i en bok\",\"Sammanfatta första kapitlet i en bok\",\"Kan du sammanfatta första kapitlet i en bok? Jag behöver en kortfattad översikt över viktiga händelser. Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",{\"_23\":4147,\"_4079\":4129,\"_4081\":4148,\"_4083\":4149,\"_2070\":4150,\"_4086\":4133,\"_4088\":4134,\"_4135\":73},\"6b65daeb\",\"en vetenskaplig artikel\",\"Sammanfatta en vetenskaplig artikel\",\"Kan du sammanfatta en vetenskaplig artikel åt mig? Jag behöver en kort sammanfattning av huvudsakliga resultat och slutsatser. Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",{\"_23\":4152,\"_4079\":4153,\"_4081\":4154,\"_4083\":4155,\"_2070\":4156,\"_4086\":4157,\"_4088\":4158,\"_4159\":73,\"_4135\":73},\"386dcd33\",\"Hjälp mig\",\"ta reda på vilket årtionde ett foto är taget\",\"Hjälp mig ta reda på vilket årtionde ett foto är taget\",\"Kan du avgöra under vilket årtionde ett foto som jag ger dig är taget? Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",\"Analysera bilder\",\"vision\",\"requires_vision\",{\"_23\":4161,\"_4079\":4153,\"_4081\":4162,\"_4083\":4163,\"_2070\":4164,\"_4086\":4157,\"_4088\":4158,\"_4159\":73,\"_4135\":73},\"ee0ca7da\",\"översätta texten i en bild som jag delar\",\"Hjälp mig översätta texten i en bild\",\"Kan du översätta texten i en bild som jag ger dig? Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",{\"_23\":4166,\"_4079\":4153,\"_4081\":4167,\"_4083\":4168,\"_2070\":4169,\"_4086\":4157,\"_4088\":4158,\"_4159\":73,\"_4135\":73},\"af82c9ba\",\"skriva en dikt baserat på en bild\",\"Hjälp mig skriva en dikt baserat på en bild\",\"Kan du skriva en dikt baserat på en bild som jag ger dig? Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",{\"_23\":4171,\"_4079\":4153,\"_4081\":4172,\"_4083\":4173,\"_2070\":4174,\"_4086\":4157,\"_4088\":4158,\"_4159\":73,\"_4135\":73},\"3ee74c99\",\"identifiera växter i en bild\",\"Hjälp mig identifiera växter i en bild\",\"Kan du hjälpa mig identifiera växter i en bild som jag ger dig? Om du vill ha mer information kan du ställa en uppföljningsfråga eller be mig ladda upp en fil eller bild.\",{\"_23\":4176,\"_4079\":4177,\"_4081\":4178,\"_4083\":4179,\"_2070\":4180,\"_4086\":4177,\"_4088\":4181},\"cf757c70\",\"Överraska mig\",\"med en berättelse om dig själv\",\"Överraska mig med en berättelse om dig själv\",\"Kan du överraska mig med en berättelse om dig själv? Jag vill höra något oväntat och intressant.\",\"misc\",{\"_23\":4183,\"_4079\":4177,\"_4081\":4184,\"_4083\":4185,\"_2070\":4186,\"_4086\":4177,\"_4088\":4181},\"df4e5926\",\"med mitt horoskop för dagen\",\"Överraska mig med mitt horoskop för dagen\",\"Hitta mitt horoskop för dagen baserat på mitt stjärntecken.\",{\"_23\":4188,\"_4079\":4177,\"_4081\":4189,\"_4083\":4190,\"_2070\":4191,\"_4086\":4177,\"_4088\":4181},\"99ebe26c\",\"med en färganalys för att hitta min årstid\",\"Överraska mig med en färganalys för att hitta min årstid\",\"Gör en färganalys för att hitta min årstid baserat på ett foto.\",{\"_23\":4193,\"_4079\":4177,\"_4081\":4194,\"_4083\":4195,\"_2070\":4196,\"_4086\":4177,\"_4088\":4181},\"0a2a8e86\",\"med ett tips från bondepraktikan\",\"Överraska mig med ett tips från bondepraktikan\",\"Slå upp bondepraktikan och se efter vad som passar att göra idag.\",{\"_23\":4198,\"_4079\":4199,\"_4081\":4200,\"_4083\":4201,\"_2070\":4202,\"_4086\":4199,\"_4088\":4203},\"9d22d26b\",\"Få råd\",\"om ett svårt samtal\",\"Få råd om ett svårt samtal\",\"Kan du hjälpa mig förbereda inför ett svårt samtal? Börja med att fråga om sammanhanget och vem jag ska tala med.\",\"teach-or-explain\",{\"_23\":4205,\"_4079\":4199,\"_4081\":4206,\"_4083\":4207,\"_2070\":4208,\"_4086\":4199,\"_4088\":4203},\"6ab41284\",\"om löneförhandlingar\",\"Få råd om löneförhandlingar\",\"Kan du vägleda mig genom en löneförhandling. Börja med att fråga om det är ett nytt eller nuvarande jobb.\",{\"_23\":4210,\"_4079\":4199,\"_4081\":4211,\"_4083\":4212,\"_2070\":4213,\"_4086\":4199,\"_4088\":4203},\"f591ec80\",\"om att flytta till en ny stad\",\"Få råd om att flytta till en ny stad\",\"Jag funderar på att flytta till en ny stad. Kan du hjälpa mig planera flytten?\",{\"_23\":4215,\"_4079\":4199,\"_4081\":4216,\"_4083\":4217,\"_2070\":4218,\"_4086\":4199,\"_4088\":4203},\"88bf1346\",\"om beteenden hos småbarn\",\"Få råd om beteenden hos småbarn\",\"Kan du ge mig råd om hur man hanterar krångliga beteenden hos småbarn? Börja med att fråga vilka specifika problem jag står inför.\",{\"_23\":4220,\"_4079\":4221,\"_4081\":4222,\"_4083\":4223,\"_2070\":4224,\"_4086\":4221,\"_4088\":4111},\"be42e2c4\",\"Gör en plan\",\"för att få mig befordrad\",\"Gör en plan för att få mig befordrad\",\"Jag vill bli befordrad på jobbet. Vi pratar igenom hur det kan gå till och upprättar en detaljerad plan. Börja med att fråga om min nuvarande roll.\",{\"_23\":4226,\"_4079\":4221,\"_4081\":4227,\"_4083\":4228,\"_2070\":4229,\"_4086\":4221,\"_4088\":4111},\"7fc44393\",\"för att köpa en ny bil\",\"Gör en plan för att köpa en ny bil\",\"Jag vill köpa en ny bil. Börja med att fråga mig om budget och vilka funktioner som är viktigast för mig. Ge mig sedan ett förslag.\",{\"_23\":4231,\"_4079\":4221,\"_4081\":4232,\"_4083\":4233,\"_2070\":4234,\"_4086\":4221,\"_4088\":4111},\"6d894365\",\"med veckans måltider\",\"Gör en plan över veckans måltider\",\"Hjälp mig planera veckans måltider. Börja med att fråga vilka ingredienser jag redan har och vilka slags rätter jag tycker om.\",{\"_23\":4236,\"_4079\":4221,\"_4081\":4237,\"_4083\":4238,\"_2070\":4239,\"_4086\":4221,\"_4088\":4111},\"26a8621b\",\"för en helg i New York\",\"Gör en plan för en helg i New York\",\"Hjälp mig planera en helg i New York. Börja med att fråga vad jag tycker om att göra och vilken tid på året det är.\",{\"_23\":4241,\"_4079\":4242,\"_4081\":4243,\"_4083\":4244,\"_2070\":4245,\"_4086\":4242,\"_4088\":4246},\"2130e4f9\",\"Hjälp mig skriva\",\"ett personligt brev\",\"Hjälp mig skriva ett personligt brev\",\"Hjälp mig skriva ett personligt brev. Fråga om utbildning, färdigheter och erfarenhet för att komma igång.\",\"write\",{\"_23\":4248,\"_4079\":4242,\"_4081\":4249,\"_4083\":4250,\"_2070\":4251,\"_4086\":4242,\"_4088\":4246},\"cfc1fd28\",\"ett blogginlägg\",\"Hjälp mig skriva ett blogginlägg\",\"Hjälp mig skriva ett blogginlägg. Fråga om ämne och ton för att komma igång.\",{\"_23\":4253,\"_4079\":4242,\"_4081\":4254,\"_4083\":4255,\"_2070\":4256,\"_4086\":4242,\"_4088\":4246},\"d571f77d\",\"ett manus\",\"Hjälp mig skriva ett manus\",\"Kan du hjälpa mig skriva ett manus i en viss genre?\",{\"_23\":4258,\"_4079\":4242,\"_4081\":4259,\"_4083\":4260,\"_2070\":4261,\"_4086\":4242,\"_4088\":4246},\"cef26c0f\",\"en godnattsaga\",\"Hjälp mig skriva en godnattsaga\",\"Kan du hjälpa mig skriva en godnattsaga i en miljö och genre som jag väljer?\",\"total\",\"limit\",\"offset\"]\n");</script><script nonce="">window.__reactRouterContext.streamController.enqueue("P4054:[{\"_4266\":4267,\"_4336\":4337,\"_4338\":4274,\"_4339\":1603,\"_4340\":4341,\"_4079\":4345},\"categories\",[4268,4308,4316,4326],{\"_4269\":4270,\"_4271\":4272,\"_4273\":4274,\"_4275\":4276,\"_4277\":4278,\"_4081\":4272,\"_4279\":4278,\"_4280\":2578,\"_4281\":4282,\"_4283\":-7,\"_4284\":4285,\"_4286\":-7,\"_4287\":-7,\"_4288\":-7,\"_4079\":-7,\"_4289\":4290,\"_4299\":4300,\"_4301\":4302,\"_4303\":-7,\"_4304\":32,\"_4305\":32,\"_4306\":4307},\"color\",\"#5B41F9\",\"tagline\",\"Beslutar om betänketid\",\"defaultModel\",\"gpt-5\",\"label\",\"Auto\",\"shortLabel\",\"5\",\"shorterLabel\",\"subscriptionLevel\",\"categoryId\",\"gpt_5_auto\",\"subcategory\",\"renderHeaderType\",\"short_label\",\"isBeta\",\"isAlpha\",\"modelBadge\",\"supportedFeatures\",[4291,4292,4293,4294,4295,4296,4297,4298],\"targeted_reply\",\"tool_search\",\"attachment\",\"canvas_supported\",\"tool_use\",\"image\",\"custom_instructions\",\"gizmo_project\",\"suppo